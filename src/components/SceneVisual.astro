---
import type { EpisodeCta, VisualSpec } from "../types/content";

interface Props {
  visual: VisualSpec;
  cta: EpisodeCta;
}

const { visual, cta } = Astro.props;
---

<div class:list={["scene-visual", `visual-${visual.kind}`]} aria-label="Supporting visual">
  {visual.kind === "portal-shift" && (
    <div class="portal-shift">
      <div class="portal-window">
        <div class="window-bar">
          <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
          <span>{visual.portalLabel}</span>
          <span class="sync-chip">In sync</span>
        </div>
        <div class="portal-body">
          <div class="portal-sidebar" aria-hidden="true">
            <b></b><b></b><b></b><b></b><b></b>
          </div>
          <div class="portal-record">
            <span class="record-kicker">COMPANY RECORD</span>
            <strong>Northstar Systems</strong>
            <div class="property-row"><span>Segment</span><b>Mid-market</b></div>
            <div class="property-row"><span>Motion</span><b>Inbound</b></div>
            <div class="property-row"><span>Owner model</span><b>Contact-led</b></div>
            <div class="property-row"><span>Revenue model</span><b>One-off</b></div>
          </div>
        </div>
      </div>
      <div class="business-changes">
        <span class="change-label">THE BUSINESS NOW</span>
        {visual.changes.map((change, index) => (
          <div class="change-chip" style={`--delay:${index}`}><i></i>{change}</div>
        ))}
      </div>
      <div class="status-stamp"><i></i>{visual.status}</div>
    </div>
  )}

  {visual.kind === "comparison" && (
    <div class="comparison-cards">
      {visual.items.map((item, index) => (
        <article class="comparison-card" style={`--row:${index}`}>
          <div class="comparison-symptom"><span>VISIBLE SYMPTOM</span><strong>{item.symptom}</strong></div>
          <div class="comparison-diagnosis">
            <div><span>QUICK FIX</span><p>{item.assumption}</p></div>
            <div class="question-cell"><span>DEEPER QUESTION</span><p><i>?</i>{item.question}</p></div>
          </div>
        </article>
      ))}
    </div>
  )}

  {visual.kind === "state-model" && (
    <div class="state-model">
      <div class="state-rail" aria-hidden="true"></div>
      {visual.states.map((state, index) => (
        <article class="state-card" style={`--state:${index}`}>
          <span>{state.number}</span>
          <strong>{state.label}</strong>
          <p>{state.detail}</p>
        </article>
      ))}
      <div class="state-centre"><span></span><strong>{visual.centre}</strong></div>
    </div>
  )}

  {visual.kind === "drift-types" && (
    <div class="drift-types">
      {visual.types.map((type, index) => (
        <article class="drift-type" style={`--type:${index}`}>
          <div class="drift-type-head"><span>0{index + 1}</span><strong>{type.label}</strong></div>
          <div class="drift-path"><span>{type.from}</span><i></i><span>{type.to}</span></div>
          <div class="drift-status"><i></i>{type.status}</div>
        </article>
      ))}
    </div>
  )}

  {visual.kind === "chain" && (
    <div class="drift-chain">
      {visual.steps.map((step, index) => (
        <div class:list={["chain-step", index === visual.hinge && "is-hinge"]} style={`--step:${index}`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{step}</strong>
          {index < visual.steps.length - 1 && <i aria-hidden="true">→</i>}
        </div>
      ))}
      <div class="hinge-note">THE HINGE</div>
    </div>
  )}

  {visual.kind === "motion-contrast" && (
    <div class="motion-contrast">
      <div class="before-model">
        <span class="map-label">ORIGINAL MODEL</span>
        {visual.before.map((item) => <div class="record-pill"><i></i>{item}</div>)}
      </div>
      <div class="motion-change"><span>+</span><strong>{visual.change}</strong><i></i></div>
      <div class="after-model">
        <span class="map-label">NEW OPERATING REQUIREMENTS</span>
        {visual.after.map((item) => <div class="record-pill"><i></i>{item}</div>)}
      </div>
    </div>
  )}

  {visual.kind === "impact-grid" && (
    <div class="impact-grid">
      {visual.impacts.map((impact, index) => (
        <article style={`--impact:${index}`}>
          <span>{String(index + 1).padStart(2, "0")} · {impact.label}</span>
          <strong>{impact.value}</strong>
        </article>
      ))}
      <div class="collision-note"><i></i><span>Two operating models collide in one portal</span></div>
    </div>
  )}

  {visual.kind === "surface-grid" && (
    <div class:list={["surface-grid", visual.surfaces.length === 3 && "surface-grid-three"]}>
      <div class="surface-centre"><span>{visual.label ?? "IMPACT MAP"}</span><strong>{visual.centre}</strong></div>
      <div class="surface-cards">
        {visual.surfaces.map((surface, index) => (
          <article style={`--surface:${index}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><strong>{surface.label}</strong><p>{surface.detail}</p></div>
          </article>
        ))}
      </div>
    </div>
  )}

  {visual.kind === "matrix" && (
    <div class="diagnostic-cards">
      {visual.rows.map((row, index) => (
        <article class:list={["diagnostic-card", `matrix-${row.tone}`]} style={`--matrix-row:${index}`}>
          <div class="diagnostic-states">
            {row.values.map((value, valueIndex) => (
              <span><small>{visual.columns[valueIndex]}</small><b><i></i>{value}</b></span>
            ))}
          </div>
          <strong>{row.result}</strong>
        </article>
      ))}
    </div>
  )}

  {visual.kind === "dependency-map" && (
    <div class="dependency-map">
      <div class="decision-card">
        <span>COMMERCIAL DECISION</span>
        <strong>{visual.decision}</strong>
      </div>
      <div class="dependency-trunk" aria-hidden="true"></div>
      <div class="dependency-grid">
        {visual.dependencies.map((dependency, index) => (
          <div class="dependency-node" style={`--dependency:${index}`}><i></i><span>{dependency}</span></div>
        ))}
      </div>
    </div>
  )}

  {visual.kind === "control-loop" && (
    <div class="control-loop">
      <div class="change-trigger"><span>CHANGE TRIGGER</span><strong>{visual.trigger}</strong></div>
      <div class="control-path">
        {visual.questions.map((question, index) => (
          <div class="control-step" style={`--control:${index}`}>
            <span>{String(index + 1).padStart(2, "0")}</span><strong>{question}</strong>
          </div>
        ))}
      </div>
      <div class="control-outcome"><i></i><span>{visual.outcome}</span></div>
    </div>
  )}

  {visual.kind === "cadence" && (
    <div class="cadence-visual">
      <div class="cadence-track">
        {visual.principles.map((principle, index) => (
          <div class="cadence-point" style={`--point:${index}`}><i></i><span>{principle}</span></div>
        ))}
      </div>
      <div class="cadence-card">
        <span>RECALIBRATION CADENCE</span>
        <strong>{visual.cadence}</strong>
        <div><i></i>{visual.output}</div>
      </div>
    </div>
  )}

  {visual.kind === "pipeline-snapshot" && (
    <div class="pipeline-snapshot">
      <div class="pipeline-toolbar">
        <div><span>SALES</span><strong>New business pipeline</strong></div>
        <span class="pipeline-filter">Quarter view</span>
      </div>
      <div class="pipeline-columns">
        {visual.stages.map((stage, index) => (
          <div class="pipeline-stage" style={`--pipeline-stage:${index}`}>
            <div><strong>{stage.label}</strong><span>{stage.count}</span></div>
            <i></i><i></i>
          </div>
        ))}
      </div>
      <article class="pipeline-focus-deal">
        <div class="deal-card-head"><span>DEAL RECORD</span><strong>{visual.deal.name}</strong></div>
        <div class="deal-card-value">{visual.deal.amount}</div>
        <dl>
          <div><dt>Stage</dt><dd>{visual.deal.stage}</dd></div>
          <div><dt>Forecast</dt><dd>{visual.deal.forecast}</dd></div>
          <div><dt>Probability</dt><dd>{visual.deal.probability}</dd></div>
        </dl>
      </article>
      <div class="pipeline-alerts">
        {visual.alerts.map((alert) => <span><i></i>{alert}</span>)}
      </div>
    </div>
  )}

  {visual.kind === "stage-claim" && (
    <div class="stage-claim">
      <article class="claim-stage-card">
        <span>DEAL STAGE</span>
        <strong>{visual.stage}</strong>
        <p>{visual.statement}</p>
      </article>
      <div class="claim-operator" aria-hidden="true">=</div>
      <div class="claim-evidence">
        <span>TRACEABLE EVIDENCE</span>
        {visual.evidence.map((item, index) => (
          <div><i>{String(index + 1).padStart(2, "0")}</i><strong>{item}</strong></div>
        ))}
      </div>
      <div class="claim-verdict"><i></i>{visual.verdict}</div>
    </div>
  )}

  {visual.kind === "truth-chain" && (
    <div class="truth-chain">
      <div class="truth-chain-track">
        {visual.steps.map((step, index) => (
          <div class="truth-step" style={`--truth-step:${index}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{step}</strong>
            {index < visual.steps.length - 1 && <i aria-hidden="true">→</i>}
          </div>
        ))}
      </div>
      <div class="truth-feedback"><i aria-hidden="true">↺</i><span>{visual.feedback}</span></div>
    </div>
  )}

  {visual.kind === "proof-ladder" && (
    <div class="proof-ladder">
      {visual.levels.map((level, index) => (
        <article class="proof-level" style={`--proof-level:${index}`}>
          <span>0{index + 1} · {level.label}</span>
          <small>{level.stages}</small>
          <strong>{level.proof}</strong>
          <p>{level.risk}</p>
        </article>
      ))}
      <div class="proof-axis"><span>Cost of a false claim</span><i></i></div>
    </div>
  )}

  {visual.kind === "control-grid" && (
    <div class="control-grid">
      {visual.controls.map((control, index) => (
        <article style={`--control-card:${index}`}>
          <div><span>0{index + 1}</span><strong>{control.label}</strong></div>
          <p>{control.question}</p>
          <small>{control.corruption}</small>
        </article>
      ))}
    </div>
  )}

  {visual.kind === "deal-record" && (
    <div class="deal-record">
      <div class="deal-record-head">
        <div><span>DEAL</span><strong>{visual.name}</strong></div>
        <b>{visual.amount}</b>
      </div>
      <div class="deal-record-body">
        {visual.fields.map((field) => (
          <div class:list={["deal-field", `deal-field-${field.tone}`]}>
            <span>{field.label}</span><strong>{field.value}</strong>
          </div>
        ))}
      </div>
      <div class="deal-record-note"><i></i>{visual.note}</div>
    </div>
  )}

  {visual.kind === "evidence-audit" && (
    <div class="evidence-audit">
      <div class="evidence-audit-head"><span>EVIDENCE REVIEW</span><strong>{visual.deal}</strong></div>
      <div class="evidence-findings">
        {visual.findings.map((finding) => (
          <article class={`evidence-${finding.strength}`}>
            <div><strong>{finding.label}</strong><span>{finding.strength}</span></div>
            <p>{finding.evidence}</p>
          </article>
        ))}
      </div>
    </div>
  )}

  {visual.kind === "deal-reconstruction" && (
    <div class="deal-reconstruction">
      <div class="reconstruction-verdict"><span>MANAGER VERDICT</span><strong>{visual.verdict}</strong></div>
      <div class="reconstruction-table">
        {visual.changes.map((change) => (
          <div>
            <span>{change.label}</span>
            <del>{change.from}</del>
            <i aria-hidden="true">→</i>
            <ins>{change.to}</ins>
          </div>
        ))}
      </div>
      <div class="reconstruction-actions">
        {visual.actions.map((action, index) => <span><i>{index + 1}</i>{action}</span>)}
      </div>
    </div>
  )}

  {visual.kind === "evidence-layers" && (
    <div class="evidence-layers">
      {visual.layers.map((layer, index) => (
        <article style={`--evidence-layer:${index}`}>
          <span>0{index + 1}</span>
          <div><strong>{layer.label}</strong><p>{layer.purpose}</p></div>
          <small>{layer.examples}</small>
        </article>
      ))}
      <div class="manager-rail"><i></i><span>{visual.manager}</span></div>
    </div>
  )}

  {visual.kind === "identity-stack" && (
    <div class="identity-stack">
      <div class="identity-stack-head">
        <span>REAL-WORLD CUSTOMER</span>
        <strong>{visual.entity}</strong>
        <i aria-hidden="true"></i>
      </div>
      <div class="identity-records">
        {visual.records.map((record, index) => (
          <article style={`--identity-record:${index}`}>
            <div><span>COMPANY RECORD {index + 1}</span><b>{record.origin}</b></div>
            <strong>{record.name}</strong>
            <dl>
              <div><dt>Owner</dt><dd>{record.owner}</dd></div>
              <div><dt>Evidence</dt><dd>{record.evidence}</dd></div>
            </dl>
          </article>
        ))}
      </div>
      <div class="identity-stack-status"><i></i>{visual.status}</div>
    </div>
  )}

  {visual.kind === "recurrence-loop" && (
    <div class="recurrence-loop">
      <div class="recurrence-source"><span>DUPLICATE FACTORY</span><strong>{visual.source}</strong></div>
      <div class="recurrence-track">
        {visual.steps.map((step, index) => (
          <article style={`--loop-step:${index}`}>
            <span>0{index + 1}</span>
            <strong>{step.label}</strong>
            <p>{step.detail}</p>
            {index < visual.steps.length - 1 && <i aria-hidden="true">→</i>}
          </article>
        ))}
      </div>
      <div class="recurrence-return"><span aria-hidden="true">↺</span><strong>{visual.result}</strong></div>
    </div>
  )}

  {visual.kind === "identity-failures" && (
    <div class="identity-failures">
      <article class="failure-fragmentation">
        <div class="failure-heading"><span>01</span><strong>Fragmentation</strong></div>
        <div class="fragmentation-map">
          <div class="real-entity">{visual.fragmentation.entity}</div>
          <i aria-hidden="true">→</i>
          <div class="record-copies">
            {visual.fragmentation.records.map((record) => <span>{record}</span>)}
          </div>
        </div>
        <p>{visual.fragmentation.consequence}</p>
      </article>
      <article class="failure-collision">
        <div class="failure-heading"><span>02</span><strong>Collision</strong></div>
        <div class="collision-map">
          <div class="related-entities">
            {visual.collision.entities.map((entity) => <span>{entity}</span>)}
          </div>
          <i aria-hidden="true">→</i>
          <div class="collided-record">{visual.collision.record}</div>
        </div>
        <p>{visual.collision.consequence}</p>
      </article>
      <div class="identity-principle"><i></i>{visual.principle}</div>
    </div>
  )}

  {visual.kind === "entity-boundary" && (
    <div class="entity-boundary">
      <div class="boundary-question"><span>IDENTITY QUESTION</span><strong>{visual.question}</strong></div>
      <div class="boundary-options">
        {visual.options.map((option, index) => (
          <article style={`--boundary-option:${index}`}>
            <span>0{index + 1}</span>
            <strong>{option.label}</strong>
            <p>{option.decision}</p>
          </article>
        ))}
      </div>
      <div class="boundary-rule"><i></i>{visual.rule}</div>
    </div>
  )}

  {visual.kind === "identity-model" && (
    <div class="identity-model">
      <div class="identity-model-centre"><span>{visual.phase}</span><strong>{visual.centre}</strong></div>
      <div class="identity-model-grid">
        {visual.parts.map((part, index) => (
          <article style={`--identity-part:${index}`}>
            <span>0{index + 1}</span>
            <div><strong>{part.label}</strong><p>{part.detail}</p></div>
          </article>
        ))}
      </div>
    </div>
  )}

  {visual.kind === "match-router" && (
    <div class="match-router">
      <div class="match-input"><span>INCOMING RECORD</span><strong>{visual.input}</strong></div>
      <div class="match-routes">
        {visual.routes.map((route) => (
          <article class={`match-${route.tone}`}>
            <div><span>{route.label}</span><strong>{route.action}</strong></div>
            <p>{route.evidence}</p>
          </article>
        ))}
      </div>
      <div class="match-principle"><i></i>{visual.principle}</div>
    </div>
  )}

  {visual.kind === "ingress-map" && (
    <div class="ingress-map">
      <div class="ingress-sources">
        <span>ENTRY PATHS</span>
        <div>{visual.sources.map((source) => <strong>{source}</strong>)}</div>
      </div>
      <div class="ingress-hub"><span>IDENTITY CONTROL</span><i></i></div>
      <div class="ingress-decisions">
        <span>ALLOWED DECISIONS</span>
        <div>{visual.decisions.map((decision) => <strong>{decision}</strong>)}</div>
      </div>
      <div class="ingress-control"><i></i>{visual.control}</div>
    </div>
  )}

  {visual.kind === "company-identity" && (
    <div class:list={["company-identity", `company-identity-${visual.mode}`]}>
      <div class="company-identity-head">
        <span>{visual.label}</span>
        <div>{visual.signals.map((signal) => <b>{signal}</b>)}</div>
      </div>
      <div class="company-record-grid">
        {visual.records.map((record, index) => (
          <article class={`company-record-${record.status}`} style={`--company-record:${index}`}>
            <span>COMPANY</span>
            <strong>{record.name}</strong>
            <p>{record.meta}</p>
          </article>
        ))}
      </div>
      <div class="company-verdict"><i></i>{visual.verdict}</div>
    </div>
  )}

  {visual.kind === "duplicate-factory" && (
    <div class="duplicate-factory">
      <div class="factory-head"><span>IDENTITY RISK REVIEW</span><strong>Find the source, then measure the consequence.</strong></div>
      <div class="factory-body">
        <div class="factory-sources">
          <span>CREATION PATH</span>
          {visual.sources.map((source) => (
            <article class={`factory-${source.tone}`}>
              <i></i><strong>{source.label}</strong><p>{source.signal}</p>
            </article>
          ))}
        </div>
        <div class="factory-impact">
          <span>IMPACT FILTERS</span>
          <div>{visual.impactChecks.map((check) => <strong><i></i>{check}</strong>)}</div>
        </div>
      </div>
      <div class="factory-outcome"><i></i>{visual.outcome}</div>
    </div>
  )}

  {visual.kind === "integration-health" && (
    <div class="integration-health">
      <div class="integration-health-head">
        <div><span>CONNECTED APP</span><strong>{visual.app}</strong></div>
        <b><i></i>{visual.syncStatus}</b>
      </div>
      <div class="integration-flow">
        <article><span>SOURCE</span><strong>{visual.source}</strong></article>
        <div class="integration-flow-line"><i></i><span>records updating</span><i></i></div>
        <article><span>DESTINATION</span><strong>{visual.destination}</strong></article>
      </div>
      <div class="integration-dependants">
        {visual.dependants.map((dependant) => (
          <article class={`integration-${dependant.status}`}><i></i><strong>{dependant.label}</strong><span>{dependant.status === "ok" ? "Healthy" : "Wrong"}</span></article>
        ))}
      </div>
      <div class="integration-symptom"><i></i>{visual.symptom}</div>
    </div>
  )}

  {visual.kind === "map-anatomy" && (
    <div class="map-anatomy">
      <div class="map-anatomy-layers">
        {visual.layers.map((layer, index) => (
          <article style={`--map-layer:${index}`}>
            <span>0{index + 1}</span>
            <div><strong>{layer.label}</strong><p>{layer.role}</p></div>
            <b>{layer.outcome}</b>
          </article>
        ))}
      </div>
      <div class="map-anatomy-principle"><i></i>{visual.principle}</div>
    </div>
  )}

  {visual.kind === "interface-contract" && (
    <div class="interface-contract">
      <div class="interface-contract-head"><span>{visual.section}</span><strong>{visual.purpose}</strong></div>
      <div class:list={["interface-contract-items", visual.items.length === 2 && "interface-contract-two"]}>
        {visual.items.map((item) => (
          <article>
            <span>{item.number}</span>
            <div><strong>{item.label}</strong><p>{item.question}</p></div>
            <b>{item.evidence}</b>
          </article>
        ))}
      </div>
    </div>
  )}

  {visual.kind === "interface-path" && (
    <div class="interface-path">
      <div class="interface-path-source"><span>SOURCE EVENT</span><strong>{visual.source}</strong></div>
      <div class="interface-path-grid">
        {visual.steps.map((step, index) => (
          <article class={`interface-path-${step.state}`} style={`--path-step:${index}`}>
            <span>{String(index + 1).padStart(2, "0")}</span><strong>{step.label}</strong><i></i>
          </article>
        ))}
      </div>
      <div class="interface-path-decision"><i></i><span>OPERATING DECISION</span><strong>{visual.decision}</strong></div>
    </div>
  )}

  {visual.kind === "semantic-break" && (
    <div class="semantic-break">
      <div class="semantic-field">
        <span>GOVERNED PROPERTY</span><strong>{visual.field}</strong>
        <div class="semantic-values">{visual.expected.map((value) => <b>{value}</b>)}</div>
      </div>
      <div class="semantic-change"><span>Provider output changed</span><strong>{visual.received}</strong><i></i></div>
      <div class="semantic-consumers">
        {visual.consumers.map((consumer) => (
          <article><i></i><div><strong>{consumer.label}</strong><p>{consumer.outcome}</p></div></article>
        ))}
      </div>
      <div class="semantic-verdict"><i></i>{visual.verdict}</div>
    </div>
  )}

  {visual.kind === "close" && (
    <div class="close-visual">
      <div class="close-question">{visual.question}</div>
      <div class="close-states">
        {visual.states.map((state, index) => (
          <div style={`--close:${index}`}><span>0{index + 1}</span><strong>{state}</strong></div>
        ))}
      </div>
      <a class="button button-primary close-cta" href={cta.url} target="_blank" rel="noreferrer">
        {visual.ctaLabel} <span aria-hidden="true">→</span>
      </a>
      <p>{cta.note}</p>
    </div>
  )}
</div>
